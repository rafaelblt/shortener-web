{
  "name": "shortener-web",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --mode simulation",
    "dev:real": "vite",
    "build": "vite build",
    "build:simulation": "vite build --mode simulation",
    "preview": "vite preview",
    "start": "node server/main.ts",
    "server": "node --env-file-if-exists=.env server/main.ts",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "typecheck": "tsc -b",
    "layers": "depcruise src server tests --config .dependency-cruiser.cjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contracts:update": "cp ../go-auth/docs/api/openapi.yaml contracts/go-auth.openapi.yaml && cp ../shortener/docs/service/openapi.yaml contracts/shortener.openapi.yaml && npm run contracts:types",
    "contracts:types": "openapi-typescript contracts/go-auth.openapi.yaml -o contracts/go-auth.ts && openapi-typescript contracts/shortener.openapi.yaml -o contracts/shortener.ts",
    "contracts:check": "openapi-typescript contracts/go-auth.openapi.yaml -o contracts/go-auth.ts --check && openapi-typescript contracts/shortener.openapi.yaml -o contracts/shortener.ts --check",
    "check": "npm run lint && npm run contracts:check && npm run typecheck && npm run layers && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
