# The variables of the server, for npm run server. See docs/architecture/server.md#settings
# true serves the simulation, which needs no back end, and none of the other variables but PORT.
SIMULATION=
GO_AUTH_URL=http://localhost:8080
SHORTENER_URL=http://localhost:8000
# 32 random bytes in base64: openssl rand -base64 32
SESSION_KEY=
PORT=3000
CLIENT_ADDRESS_HEADER=
